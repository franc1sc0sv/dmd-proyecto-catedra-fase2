# Copiar a .env (no se sube a Git) y ajustar.
DB_SERVER=localhost
DB_NAME=AndinaRetailDW
DB_DRIVER=ODBC Driver 18 for SQL Server
# Con el driver 18 la conexión va cifrada; en un SQL Server local de desarrollo el certificado no es de confianza.
DB_TRUST_SERVER_CERTIFICATE=yes
# Vacío = autenticación de Windows. Para usuario SQL, completar ambos:
DB_USER=
DB_PASSWORD=
